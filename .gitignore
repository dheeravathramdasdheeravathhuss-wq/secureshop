
# =========================
# SecureShop - Git Ignore
# =========================

# Environment variables and secrets
.env
.env.*
!.env.example

# Dependencies
node_modules/
vendor/

# Build and distribution files
dist/
build/
coverage/

# Logs and debug files
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Local databases and database backups
*.sqlite
*.sqlite3
*.db
*.sql.bak

# Test reports
test-results/
playwright-report/

# IDE and editor settings
.vscode/
.idea/
*.sublime-workspace

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.bak
*.swp

# Local configuration
.env.local
.env.development.local
.env.test.local
.env.production.local

# SecureShop local development data
secureshop-local-data.json
secureshop-debug.log

# Certificates and private keys
*.pem
*.key
*.p12
*.pfx

# Do not commit real credentials or secrets
secrets.json
credentials.jso
